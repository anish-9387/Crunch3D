# ── Backend (used by Docker / Render) ──
BACKEND_PORT=8000
MAX_FILE_SIZE_MB=50

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Regex for matching CORS origins (e.g. Vercel preview deployments)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Cloud storage ────────────────────────────────────────────────────────────
# Mesh uploads and optimized outputs are stored in an S3-compatible bucket.
# Cloudflare R2 is recommended (S3 API + $0 egress on downloads). AWS S3,
# MinIO, Backblaze B2 etc. work too — just change the endpoint/region.
#
#   STORAGE_BACKEND=local disables the bucket entirely (default, dev-safe).
#   STORAGE_BACKEND=cloud requires the four CLOUD_STORAGE_* vars below.
#
# R2 setup:
#   1. Create a bucket in the Cloudflare dashboard (name it, e.g. "crunch3d")
#   2. R2 → "Manage R2 API Tokens" → create an object-read/write token
#   3. Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. Region: auto
STORAGE_BACKEND=local
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_REGION=auto
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_BUCKET=crunch3d

# ── Download quota ───────────────────────────────────────────────────────────
# Users may optimize unlimited times, but can download at most this many
# optimized results per rolling 24h window (per anonymous device id).
MAX_DOWNLOADS_PER_DAY=5

# ── Self-learning AI ─────────────────────────────────────────────────────────
# The GNN that guides mesh (and colour/texture) preservation keeps learning
# from every optimization the service performs.
LEARNING_AUTO_RETRAIN=true
LEARNING_RETRAIN_INTERVAL_MINUTES=30
LEARNING_MIN_NEW_SAMPLES=5
LEARNING_RETRAIN_EPOCHS=12
# Target size of the procedurally generated "large dataset" the model starts from
SEED_DATASET_COUNT=800

# ── Frontend (used by Vite / Vercel) ──
# For local dev: http://localhost:8000
# For production: https://your-app.onrender.com
VITE_API_BASE_URL=http://localhost:8000